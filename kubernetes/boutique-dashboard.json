{
  "title": "Online Boutique",
  "uid": "online-boutique",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["boutique", "microservices"],
  "panels": [
    {
      "id": 1,
      "title": "Running Pods",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color":"red","value":0},{"color":"yellow","value":5},{"color":"green","value":9}] } } },
      "targets": [{ "expr": "count(kube_pod_status_phase{namespace=\"boutique\",phase=\"Running\"})", "legendFormat": "Running Pods" }]
    },
    {
      "id": 2,
      "title": "Error Logs (last 1h)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":5},{"color":"red","value":20}] } } },
      "targets": [{ "expr": "count_over_time({namespace=\"boutique\"} |= \"error\" [1h])", "legendFormat": "Errors" }]
    },
    {
      "id": 3,
      "title": "CPU Usage by Pod",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores", "custom": { "lineWidth": 2 } } },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"boutique\",container!=\"\"}[2m])) by (pod)", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 4,
      "title": "Memory Usage by Pod",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } },
      "targets": [{ "expr": "sum(container_memory_working_set_bytes{namespace=\"boutique\",container!=\"\"}) by (pod)", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 5,
      "title": "Network Receive by Pod",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2 } } },
      "targets": [{ "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"boutique\"}[2m])) by (pod)", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 6,
      "title": "Network Transmit by Pod",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2 } } },
      "targets": [{ "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"boutique\"}[2m])) by (pod)", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 7,
      "title": "Pod Restarts",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [{ "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"boutique\"}[1h])", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 8,
      "title": "Pod Status",
      "type": "table",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "sortBy": [{ "displayName": "Pod" }] },
      "targets": [{ "expr": "kube_pod_status_phase{namespace=\"boutique\"}", "legendFormat": "{{pod}} - {{phase}}", "instant": true, "format": "table" }]
    },
    {
      "id": 9,
      "title": "Boutique Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "dedupStrategy": "none", "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{namespace=\"boutique\"}", "legendFormat": "" }]
    },
    {
      "id": 10,
      "title": "Error Logs Only",
      "type": "logs",
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "dedupStrategy": "none", "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{namespace=\"boutique\"} |= \"error\"", "legendFormat": "" }]
    },
    {
      "id": 11,
      "title": "Traces - Recent Requests",
      "type": "table",
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "queryType": "traceql", "query": "{}", "tableType": "traces", "limit": 20 }]
    }
  ]
}
